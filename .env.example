# انسخ هذا الملف إلى .env.local ثم املأ القيم من:
# Firebase Console ← Project settings ← Your apps ← Web app ← SDK setup and configuration
# إن تُرك فارغًا يعمل التطبيق في "وضع العرض التجريبي" ببيانات محلية داخل المتصفح.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# اجبار وضع العرض التجريبي حتى مع وجود إعدادات Firebase (true/false)
VITE_FORCE_DEMO=false

# للتطوير على محاكي Firebase (npm run emulators ثم npm run dev:emulator)
VITE_USE_EMULATOR=false
